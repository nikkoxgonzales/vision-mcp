# vision-mcp — provider-agnostic config (any OpenAI-compatible vision endpoint)

# Required: API key for your provider
AI_API_KEY=your_api_key

# Optional: base URL of an OpenAI-compatible /chat/completions endpoint.
# Omit to use the AI_MODE preset default.
#AI_BASE_URL=https://api.openai.com/v1/

# Optional: vision model name (default: glm-4.6v)
#AI_VISION_MODEL=gpt-4o

# Optional: platform preset when AI_BASE_URL is not set (ZAI or ZHIPU)
#AI_MODE=ZAI

# Optional tunables
#AI_VISION_MODEL_TEMPERATURE=0.8
#AI_VISION_MODEL_TOP_P=0.6
#AI_VISION_MODEL_MAX_TOKENS=32768
#AI_TIMEOUT=300000
#AI_RETRY_COUNT=1
